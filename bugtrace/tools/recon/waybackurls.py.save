import subprocess

def scan(domain: str):
    try:
        result = subprocess.run(
            ["waybackurls"],
            input=domain,
            text=True,
            capture_output=True,
            timeout=120
        )

        return [
            line.strip()
            for line in result.stdout.splitlines()
            if line.strip()
        ]

    except Exception as e:
        print(f"Waybackurls error: {e}")
        return []

